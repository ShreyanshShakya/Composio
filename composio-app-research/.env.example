# Composio API (for Firecrawl integration)
COMPOSIO_API_KEY=your_composio_api_key_here
COMPOSIO_BASE_URL=https://backend.composio.dev/api/v1

# LLM extraction provider: gemini (recommended) or nemotron
LLM_PROVIDER=gemini

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# NVIDIA Nemotron API (optional fallback)
NVIDIA_API_KEY=your_nvidia_api_key_here
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b

# Optional: Firecrawl direct (fallback)
# FIRECRAWL_API_KEY=your_firecrawl_key_here

# Optional: Other search APIs
# TAVILY_API_KEY=your_tavily_key_here
# SERPER_API_KEY=your_serper_key_here
